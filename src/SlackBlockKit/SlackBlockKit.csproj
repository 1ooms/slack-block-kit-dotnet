<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>SlackBlockKit</RootNamespace>
        <PackageId>SlackBlockKit</PackageId>
        <Version>1.0.0</Version>
        <Authors>Lukas Ooms</Authors>
        <Description>A strongly typed .NET library for building Slack Block Kit UIs in C# with fluent builders and native System.Text.Json serialization.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/1ooms/slack-block-kit-dotnet</RepositoryUrl>
        <PackageTags>slack;block-kit;slack-bot;csharp;dotnet</PackageTags>
    </PropertyGroup>

</Project>
