<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RollForward>Major</RollForward>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
        <Using Include="System.Text.Json"/>
        <Using Include="SlackBlockKit.Blocks"/>
        <Using Include="SlackBlockKit.CompositionObjects"/>
        <Using Include="SlackBlockKit.CompositionObjects.TextObjects"/>
        <Using Include="SlackBlockKit.Elements"/>
        <Using Include="SlackBlockKit.Elements.MultiSelectMenu"/>
        <Using Include="SlackBlockKit.Elements.RichText"/>
        <Using Include="SlackBlockKit.Elements.SelectMenu"/>
        <Using Include="SlackBlockKit.Surfaces"/>
        <Using Include="SlackBlockKit.Tests.TestHelpers" Static="true"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.2">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0"/>
        <PackageReference Include="xunit" Version="2.5.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\SlackBlockKit\SlackBlockKit.csproj"/>
    </ItemGroup>

</Project>
